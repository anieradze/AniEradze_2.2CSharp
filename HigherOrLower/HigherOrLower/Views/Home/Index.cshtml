@{
    ViewData["Title"] = "Home Page";
}

<div class="game-container">
    <div class="score-board">
        <h2>Score: 0</h2>
    </div>

    <div class="comparison">

        <div class="card left-card">
            <img src="https://via.placeholder.com/200x300.png?text=Nepal+Earthquake" alt="Nepal Earthquake" class="card-img" />
            <div class="card-name">Nepal Earthquake</div>
            <div class="card-result">9,800,000</div>
        </div>

        <div class="compare-buttons">
            <button class="btn btn-higher">Higher</button>
            <button class="btn btn-lower">Lower</button>
        </div>

        <div class="card right-card">
            <img src="~/images/minecraft.jpg" alt="Minecraft" class="card-img" />
            <div class="card-name">Minecraft</div>
            <div class="card-result">???</div>
        </div>

    </div>
</div>